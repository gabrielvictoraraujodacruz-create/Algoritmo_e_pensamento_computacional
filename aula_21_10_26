#include <stdio.h>

void exibirMenu() {
    printf("\n=== SISTEMA BANCÁRIO ===\n");
    printf("1. Consultar Saldo\n");
    printf("2. Depositar\n");
    printf("3. Sacar\n");
    printf("4. Definir limite\n");
    printf("5. Sair\n");
    printf("Escolha uma opção: ");
}

int main() {
    int opcao;
    float saldo = 1000.0;
    float valor;
    float limite_especial = 0.0;

    do {
        exibirMenu();
        if (scanf("%d", &opcao) != 1) {
            while (getchar() != '\n');
            opcao = 0;
        }

        switch (opcao) {
            case 1:
                printf("Saldo em conta: R$ %.2f\n", saldo);
                printf("Limite do cheque especial: R$ %.2f\n", limite_especial);
                printf("Saldo disponível (saldo + limite): R$ %.2f\n", saldo + limite_especial);
                break;
            case 2:
                printf("Digite o valor para depósito: R$ ");
                scanf("%f", &valor);
                if (valor > 0) {
                    saldo += valor;
                    printf("Depósito realizado! Novo saldo: R$ %.2f\n", saldo);
                } else {
                    printf("Valor inválido!\n");
                }
                break;
            case 3:
                printf("Digite o valor para saque: R$ ");
                scanf("%f", &valor);
                if (valor > 0 && valor <= saldo + limite_especial) {
                    saldo -= valor;
                    printf("Saque realizado! Novo saldo: R$ %.2f\n", saldo);
                } else {
                    printf("Valor inválido ou saldo insuficiente!\n");
                }
                break;
            case 4:
                printf("Digite o limite do cheque especial: R$ ");
                scanf("%f", &valor);
                if (valor < 0) {
                    printf("Valor inválido!\n");
                } else if (valor == 0) {
                    limite_especial = 0;
                    printf("Você não tem cheque especial.\n");
                } else {
                    limite_especial = valor;
                    printf("Limite definido! Cheque especial: R$ %.2f\n", limite_especial);
                }
                break;

            case 5:
                printf("Obrigado por usar nosso sistema!\n");
                break;
            default:
                printf("Opção inválida! Tente novamente.\n");
        }
    } while (opcao != 5);
    return 0;
}


