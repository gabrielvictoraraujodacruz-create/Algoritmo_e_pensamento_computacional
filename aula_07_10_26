======================================
 1. Somar
2. Subtrair
3. Multiplicar
4. Dividir
 
Escolha a operacao desejada (1-4): 4
Digite o primeiro numero: 15.0
Digite o segundo numero: 3.0
 --------------------------------------
Resultado da divisao: 5.00
======================================

#include <stdio.h>
int main(void) {
    float num1, num2, resultado;
    char operador;

    printf("------USE A CALCULADORA!!!------\n");
    printf("------Digite o primeiro número:------\n");
    scanf("%f", &num1);

    printf("------Digite o operador (+,-,*,/):------\n");
    scanf(" %c", &operador);

    printf("------Digite o segundo número:------\n");
    scanf("%f", &num2);

    switch (operador) {
        case '+':
            resultado = num1 + num2;
            printf("------O resultado da soma é: %.2f------\n", resultado);
            break;
        case '-':
        resultado = num1 - num2;
        printf("------O resultado da subtração é: %.2f------\n", resultado);
          break;
        case '*':
            resultado = num1 * num2;
            printf("------O resultado da multiplicação é: %.2f------\n", resultado);
            break;
        case '/':
            if (num2 != 0) {
                resultado = num1 / num2;
            } else {
                printf("------Erro: Divisão por zero!------\n");
                return 1;
            }
            printf("------O resultado da divisão é: %.2f------\n", resultado);
            break;
        }
}

